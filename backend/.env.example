PORT=3000
DATABASE_URL=postgres://vesper:vesper@localhost:5432/vesper
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-32+
OTP_SECRET=change-me-too-another-long-random-string

# Object storage (Cloudflare R2 in prod, MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=vesper-raw
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Used by the dev transcoder to build playable URLs (bucket allows public read locally)
S3_PUBLIC_BASE_URL=http://localhost:9000/vesper-raw

# dev | cloudflare
TRANSCODER=dev
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_WEBHOOK_SECRET=
# e.g. customer-abc123xyz (from the Stream dashboard)
CF_STREAM_CUSTOMER_CODE=
